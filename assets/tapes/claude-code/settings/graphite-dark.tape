Set Shell zsh
Set FontFamily "JetBrainsMono Nerd Font, JetBrains Mono, Menlo, monospace"
Set FontSize 18
Set Width 1800
Set Height 1000
Set Padding 20
Set TypingSpeed 45ms
Set Theme {"name": "Graphite Dark", "background": "#262626", "foreground": "#c5c8c6", "cursor": "#d0d0d0", "selection": "#444444", "black": "#000000", "red": "#fd5ff1", "green": "#87c38a", "yellow": "#ffd7b1", "blue": "#85befd", "magenta": "#b9b6fc", "cyan": "#85befd", "white": "#e0e0e0", "brightBlack": "#000000", "brightRed": "#fd5ff1", "brightGreen": "#94fa36", "brightYellow": "#f5ffa8", "brightBlue": "#96cbfe", "brightMagenta": "#b9b6fc", "brightCyan": "#85befd", "brightWhite": "#e0e0e0"}
