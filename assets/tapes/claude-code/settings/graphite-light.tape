Set Shell zsh
Set FontFamily "JetBrainsMono Nerd Font, JetBrains Mono, Menlo, monospace"
Set FontSize 18
Set Width 1800
Set Height 1000
Set Padding 20
Set TypingSpeed 45ms
Set Theme {"name": "Graphite Light", "background": "#eeeeee", "foreground": "#2a2c33", "cursor": "#bbbbbb", "selection": "#d8d8d8", "black": "#000000", "red": "#de3e35", "green": "#3f953a", "yellow": "#d2b67c", "blue": "#2f5af3", "magenta": "#950095", "cyan": "#3f953a", "white": "#bbbbbb", "brightBlack": "#000000", "brightRed": "#de3e35", "brightGreen": "#3f953a", "brightYellow": "#d2b67c", "brightBlue": "#2f5af3", "brightMagenta": "#a00095", "brightCyan": "#3f953a", "brightWhite": "#ffffff"}
